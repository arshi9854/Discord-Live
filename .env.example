# Explicitly enable only when testing with synthetic messages.
DEMO_MODE=false
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
PORT=3000

# Optional AI synthesis. Keep local until you approve sharing selected messages.
SUMMARY_PROVIDER=local
OPENROUTER_API_KEY=
# Exact model ID from your OpenRouter account, e.g. provider/model-name.
OPENROUTER_MODEL=
# Per-process guard, not a durable billing cap. Set a provider-side spending limit too.
LLM_REQUESTS_PER_HOUR=20
